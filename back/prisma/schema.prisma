generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ───────── Enums ─────────
 */
enum Role {
  Employer
  Manager
  Responsable
}

enum ContractType {
  H15
  H35
  H40
}

enum NotificationStatus {
  Presence
  Late
  Warning
}

enum WarningStatus {
  Alert
  Retard
  AbsenceNonJustifiee
}

enum VacationStatus {
  Pending
  Approved
  Refused
}

enum LeaveStatus {
  Pending
  Approved
  Refused
}

/**
 * ───────── Tables ─────────
 */

model User {
  id           Int          @id @default(autoincrement()) @map("id_user")
  firstName    String       @map("first_name")
  lastName     String       @map("last_name")
  email        String       @unique
  phoneNumber  String       @map("phone_number")
  password     String
  role         Role
  contractType ContractType @map("contract_type")
  avatarUrl    String?      @map("avatar_url")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deletedAt DateTime? @map("deleted_at")

  // relations
  warnings  Warning[]
  vacations Vacation[]
  clockings Clocking[]
  belongs   Belongs[]
  receives  Receive[]
  leaves    Leave[]

  ownedTeams Team[] // back-relation de Team.owner

  @@map("User")
  @@index([deletedAt])
}

model Team {
  id          Int    @id @default(autoincrement()) @map("id_team")
  teamName    String @map("team_name")
  description String
  ownerId     Int    @map("id_owner")
  owner       User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relations
  members Belongs[]

  @@index([ownerId])
  @@map("Team")
}

model Notification {
  id      Int                @id @default(autoincrement()) @map("id_notification")
  message String
  status  NotificationStatus
  date    DateTime           @db.Date

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relations
  receivers Receive[]

  @@map("Notification")
}

model Warning {
  id          Int           @id @default(autoincrement()) @map("id_warning")
  status      WarningStatus
  description String
  date        DateTime      @db.Date
  quantity    Int

  // FK
  userId Int  @map("id_user")
  user   User @relation(fields: [userId], references: [id], onDelete:Cascade)

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, date])
  @@map("Warning")
}

model Vacation {
  id        Int            @id @default(autoincrement()) @map("id_vacation")
  number    Int            @map("number_vacation")
  startDate DateTime       @map("start_date") @db.Date
  endDate   DateTime       @map("end_date") @db.Date
  status    VacationStatus

  // FK
  userId Int  @map("id_user")
  user   User @relation(fields: [userId], references: [id], onDelete:Cascade)

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, status])
  @@index([startDate, endDate])
  @@map("Vacation")
}

model Leave {
  id            Int         @id @default(autoincrement()) @map("id_leave")
  startDate     DateTime    @map("start_date") @db.Date
  endDate       DateTime    @map("end_date") @db.Date
  justification String
  status        LeaveStatus @default(EnAttente)
  daysLeave     Int         @map("days_leave")

  // FK
  userId Int  @map("id_user")
  user   User @relation(fields: [userId], references: [id], onDelete:Cascade)

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, startDate, endDate])
  @@map("Leave")
}

model Clocking {
  id            Int       @id @default(autoincrement()) @map("id_clocking")
  firstArrival  DateTime? @map("first_arrival") @db.Time
  lastDeparture DateTime? @map("last_departure") @db.Time
  workMinutes   Int       @default(0) @map("work_minutes")
  breakMinutes  Int       @default(0) @map("break_minutes")
  clockingDate  DateTime  @map("clocking_date") @db.Date
  totalHours    Decimal   @default(0) @map("total_hours") @db.Decimal(8, 2)
  weekDay       String    @default("") @map("week_day")
  workDay       Int       @default(0) @map("work_day")

  // FK
  userId Int  @map("id_user")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Permet plusieurs pointages par jour (pas de contrainte unique)
  @@index([userId, clockingDate])
  @@index([userId])
  @@map("Clocking")
}

/**
 * tables de jointure avec PK composite
 */
model Receive {
  userId         Int @map("id_user")
  notificationId Int @map("id_notification")

  // timestamps (utile pour tracer la réception)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([userId, notificationId])
  @@index([userId])
  @@index([notificationId])
  @@map("Receive")
}

model Belongs {
  teamId   Int      @map("id_team")
  userId   Int      @map("id_user")
  joinedAt DateTime @default(now())
  isLead   Boolean  @default(false)

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([teamId, isLead])
  @@index([userId])
  @@map("Belongs")
}
