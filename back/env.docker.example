DATABASE_URL="postgresql://app:app@db:5432/app?schema=public"
PORT=3000
JWT_ISSUER=your-jwt-issuer
JWT_AUDIENCE=your-jwt-audience

JWT_ACCESS_SECRET=your-jwt-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-characters-long
DUMMY_HASH=$$2b$$10$$your-bcrypt-hash-here

BCRYPT_ROUNDS=12




